# ==============================================================================
# CivicPilot Environment Configuration Template (.env.example)
#
# Duplicate this file to:
#   - `.env` in the root or `backend/` for FastAPI backend services
#   - `frontend/.env.local` for the Next.js App Router client
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
PROJECT_NAME="CivicPilot API"
VERSION="1.0.0"
PORT=8000
API_PREFIX="/api"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. Google Gemini AI SDK (Multimodal Reasoning, OCR & Dynamic Field Mapping)
# Required for zero-shot scheme eligibility assessment and document extraction.
# Obtain API key from Google AI Studio: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-google-gemini-api-key"

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Database, Authentication & Secure Document Vault
# Required for citizen authentication, RLS-protected profile data, and file storage.
# Obtain from Supabase Dashboard > Project Settings > API: https://supabase.com
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 4. Playwright Browser Automation Runtime
# Set to "false" to view live Chromium automation in headful desktop mode.
# ------------------------------------------------------------------------------
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_VIEWPORT_WIDTH=1280
PLAYWRIGHT_VIEWPORT_HEIGHT=800

# ------------------------------------------------------------------------------
# 5. Local Storage Directories (Deterministic fallback storage)
# ------------------------------------------------------------------------------
LOCAL_STORAGE_DIR="storage"
RECEIPTS_STORAGE_DIR="storage/receipts"

# ==============================================================================
# Frontend Environment Configuration (Copy to frontend/.env.local)
# ==============================================================================
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
